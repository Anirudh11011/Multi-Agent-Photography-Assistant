# Deploy-mode settings. On Streamlit Community Cloud paste this into
# Manage app → Settings → Secrets. Locally, copy to .streamlit/secrets.toml
# (already gitignored) — or just use .env, which is read first.

GROQ_API_KEY = ""

LANGSMITH_API_KEY = ""
LANGSMITH_PROJECT = "multi-agent-photography-assistant"
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"

# Deployed hosts have no durable disk, so point this at a managed database or
# the transcripts disappear on every restart.
DATABASE_URL = "postgresql://user:password@host:5432/dbname"

APP_ENV = "deploy"
