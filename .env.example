# Copy to .env and fill in. Never commit the filled-in file.

GROQ_API_KEY=""

# ── LangSmith tracing ────────────────────────────────────────
# From https://smith.langchain.com → Settings → API Keys.
# Leave the key blank to run with tracing off.
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="multi-agent-photography-assistant"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"

# ── Conversation recording ───────────────────────────────────
# Unset  → ./conversations.db (SQLite). Fine locally; wiped on an ephemeral host.
# Set    → that database. Required in deploy mode to keep the training corpus.
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
# CONVERSATION_DB_PATH="./conversations.db"

APP_ENV="local"
